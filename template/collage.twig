{% extends 'layout/skeleton.twig' %}
{% import 'macro/steam.twig' as steam %}

{% block title %}Collage{% endblock %}

{% block css %}
    <link rel="stylesheet" href="css/collage.css">
{% endblock %}

{% block body %}
<section>
    <div class="collage">
    {% for game in games -%}
        {{ steam.app_capsule(game, false) }}
    {%- endfor %}
    </div>
</section>
{% endblock %}
